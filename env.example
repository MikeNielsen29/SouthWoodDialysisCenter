# Environment template — copy to .env.local and fill in the real values.
# Never commit the filled file. The same names must exist in Vercel →
# Project → Settings → Environment Variables.
#
# (Named `env.example` rather than `.env.example` on purpose: the workspace
# tooling blocks creating dot-prefixed env files. `cp env.example .env.local`.)

# Google Apps Script web app (/exec URL) and its shared secret.
# GS_SHARED_SECRET must match Apps Script → Project Settings → Script Properties.
GS_WEBAPP_URL=
GS_SHARED_SECRET=

# Also stored in Script Properties; hashes IP/user-agent for audit rows.
HASH_PEPPER=

# Session signing (>= 32 bytes) and file encryption (32-byte base64, AES-256-GCM).
SESSION_SECRET=
FILE_ENCRYPTION_KEY=

# Telegram bot (FilesDB). Dedicated bot + private channel/group only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Transactional email: login OTP and appointment reminders.
RESEND_API_KEY=
MAIL_FROM=
ADMIN_ALERT_EMAIL=

# Admin publish -> on-demand cache refresh.
REVALIDATE_SECRET=

# Canonical site origin used by metadata, sitemap and emails.
NEXT_PUBLIC_SITE_URL=
