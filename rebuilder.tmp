$r = Join-Path $root 'build-singlefile.ps1'
$lines = @(
  '$root = $PSScriptRoot',
  '$out = Join-Path $root ''MIPORO-ICT-Accounting-SINGLEFILE.html''',
  '$css = Get-Content (Join-Path $root ''styles.css'') -Raw -Encoding UTF8',
  '$jsOrder = @(''data.js'',''core.js'',''app.js'',''setup.js'',''transactions.js'',''books.js'',''payroll.js'',''bir.js'',''inventory.js'',''reports.js'')',
  '$jsBlocks = ''''',
  'foreach($f in $jsOrder){',
  '  $code = Get-Content (Join-Path $root (''js\'' + $f)) -Raw -Encoding UTF8',
  '  $code = $code -replace ''</script>'', ''<\\/script>''',
  '  $jsBlocks += "`n/* ==================== js/$f ==================== */`n" + $code + "`n"',
  '}',
  '$htmlTop = @(',
  '''<!DOCTYPE html>'',',
  '''<html lang="en">'',',
  '''<head>'',',
  '''<meta charset="UTF-8">'',',
  '''<meta name="viewport" content="width=device-width, initial-scale=1.0">'',',
  '''<title>MIPORO ICT Solution</title>'',',
  '''<style>''',
  ') -join "`r`n"',
  '$htmlBot = @(',
  '''</style>'',',
  '''</head>'',',
  '''<body>'',',
  '''<div id="app">'',',
  '''  <aside id="sidebar">'',',
  '''    <div class="brand">AccSys <small>Accounting System</small></div>'',',
  '''    <nav id="nav"></nav>'',',
  '''    <div class="sidebar-footer">'',',
  '''      <div id="biz-name">-</div>'',',
  '''      <div id="biz-tin"></div>'',',
  '''      <div id="biz-type" class="badge"></div>'',',
  '''    </div>'',',
  '''  </aside>'',',
  '''  <main id="main">'',',
  '''    <header id="topbar">'',',
  '''      <button id="menu-btn" title="Toggle menu">☰</button>'',',
  '''      <h1 id="page-title">Dashboard</h1>'',',
  '''      <div id="page-actions"></div>'',',
  '''    </header>'',',
  '''    <div id="view"></div>'',',
  '''  </main>'',',
  '''</div>'',',
  '''<div id="modal-root"></div>'',',
  '''<div id="toast-root"></div>'',',
  '''<script>''',
  ') -join "`r`n"',
  '$htmlEnd = "</scr" + "ipt></body></html>"',
  'Set-Content -Path $out -Value ($htmlTop + "`r`n" + $css + "`r`n" + $htmlBot + "`r`n" + $jsBlocks + "`r`n" + $htmlEnd) -Encoding UTF8',
  '$size = [math]::Round((Get-Item $out).Length / 1KB, 1)',
  'Write-Output "BUILT: $out ($size KB)"'
)
Set-Content -Path $r -Value ($lines -join "`r`n") -Encoding UTF8
Write-Output "REWROTE build-singlefile.ps1"
. $r